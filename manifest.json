{
  "manifest_version": 3,
  "name": "STICK",
  "version": "0.1",
  "browser_specific_settings": { "gecko": { "id": "stick@hackathon.local" } },
  "permissions": ["tabs", "storage", "idle"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "background": { "scripts": ["ai.js", "inbox.js", "engine.js"] },
  "sidebar_action": {
    "default_title": "STICK",
    "default_panel": "sidebar.html",
    "open_at_install": true
  },
  "commands": {
    "_execute_sidebar_action": { "suggested_key": { "default": "Alt+Shift+S" } }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "Stickman/stick-module/stick-module/stick.config.js",
        "Stickman/stick-module/stick-module/stick.js",
        "Stickman/stick-module/stick-module/bridge.js",
        "ai-client.js",
        "reading.js",
        "glue.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "Stickman/stick-module/stick-module/assets/*.png",
        "Stickman/stick-module/stick-module/assets-placeholder/*.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
